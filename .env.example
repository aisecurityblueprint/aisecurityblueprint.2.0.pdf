# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/luna_online

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# OpenRouter LLM
OPENROUTER_API_KEY=sk-or-xxxxx

# Error Tracking
SENTRY_DSN=https://xxxxxxxxx@xxxxxxxxx.ingest.sentry.io/xxxxx

# Presidio (PII/Secrets Detection)
PRESIDIO_ANALYZER_URL=http://localhost:8002

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Service Metadata
SERVICE_NAME=luna-online-api
SERVICE_VERSION=1.0.0
